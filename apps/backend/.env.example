NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://homepilot:homepilot_dev@localhost:5432/homepilot?schema=public

# JWT
JWT_SECRET=homepilot-dev-jwt-secret-change-in-production-32chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MQTT (matches docker-compose.yml)
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=homepilot-backend

# AI (optional — leave blank for rule-based fallback)
AI_PROVIDER=
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=

# Ring (optional)
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_REDIRECT_URI=http://localhost:3000/api/ring/callback
RING_WEBHOOK_SECRET=

# App
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGIN=*
DEFAULT_TARIFF_INR_PER_KWH=8.5
