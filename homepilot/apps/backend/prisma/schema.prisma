generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

enum DeviceType {
  LIGHT
  SWITCH
  FAN
  AC
  TV
  SMART_PLUG
  CURTAIN
  GEYSER
  WASHING_MACHINE
  WATER_PUMP
  SENSOR_MOTION
  SENSOR_DOOR
  SENSOR_TEMP_HUMIDITY
  SENSOR_WATER_LEVEL
  ENERGY_METER
  CONTROLLER
}

enum CommandStatus {
  PENDING
  SENT
  ACKNOWLEDGED
  EXECUTED
  FAILED
  TIMEOUT
  REJECTED
}

enum IntegrationType {
  simulator
  mqtt_controller
  ring
  manual
}

enum ReadingSource {
  measured
  calculated
  estimated
  simulated
}

model User {
  id           String             @id @default(uuid())
  email        String             @unique
  passwordHash String
  name         String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  memberships  HouseholdMember[]
  commands     Command[]
  notifications Notification[]
}

model Household {
  id            String             @id @default(uuid())
  name          String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  members       HouseholdMember[]
  rooms         Room[]
  devices       Device[]
  commands      Command[]
  energyReadings EnergyReading[]
  automations   AutomationRule[]
  ringEvents    RingEvent[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  tariffInrPerKwh Float            @default(8.5)
}

model HouseholdMember {
  id          String    @id @default(uuid())
  userId      String
  householdId String
  role        Role      @default(MEMBER)
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([userId, householdId])
  @@index([householdId])
}

model Room {
  id          String    @id @default(uuid())
  householdId String
  name        String
  icon        String?
  sortOrder   Int       @default(0)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  devices     Device[]

  @@index([householdId])
}

model Device {
  id           String          @id @default(uuid())
  householdId  String
  roomId       String?
  name         String
  type         DeviceType
  manufacturer String?
  model        String?
  integration  IntegrationType @default(simulator)
  isSimulated  Boolean         @default(true)
  online       Boolean         @default(false)
  lastSeenAt   DateTime?
  capabilities Json            // DeviceCapability[]
  state        Json            @default("{}")
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  room         Room?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  commands     Command[]
  energyReadings EnergyReading[]

  @@index([householdId])
  @@index([roomId])
}

model Command {
  id          String        @id @default(uuid())
  householdId String
  deviceId    String
  capability  String
  payload     Json
  status      CommandStatus @default(PENDING)
  requestedBy String
  error       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  device      Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  requester   User          @relation(fields: [requestedBy], references: [id])

  @@index([householdId])
  @@index([deviceId])
  @@index([status])
}

model EnergyReading {
  id          String        @id @default(uuid())
  householdId String
  meterId     String
  deviceId    String?
  voltageV    Float?
  currentA    Float?
  powerW      Float?
  energyKwh   Float?
  frequencyHz Float?
  powerFactor Float?
  source      ReadingSource @default(simulated)
  recordedAt  DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  device      Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([householdId, recordedAt])
  @@index([meterId, recordedAt])
}

model AutomationRule {
  id              String    @id @default(uuid())
  householdId     String
  name            String
  enabled         Boolean   @default(true)
  trigger         Json
  actions         Json
  cooldownSeconds Int       @default(60)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  logs            AutomationLog[]

  @@index([householdId])
}

model AutomationLog {
  id         String         @id @default(uuid())
  ruleId     String
  success    Boolean
  message    String?
  createdAt  DateTime       @default(now())
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
}

model RingEvent {
  id          String    @id @default(uuid())
  householdId String
  deviceId    String?
  eventType   String
  payload     Json
  receivedAt  DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, receivedAt])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  householdId String
  title       String
  body        String
  type        String
  read        Boolean   @default(false)
  data        Json?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ActivityLog {
  id          String    @id @default(uuid())
  householdId String
  actorId     String?
  action      String
  entityType  String?
  entityId    String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, createdAt])
}
